# ============================================================
#  .env.example — Plantilla de variables de entorno del BACKEND
#  Curso IA SENA Piedecuesta · Clase alternativa
# ------------------------------------------------------------
#  1. Copia este archivo como  .env   (sin ".example")
#  2. Reemplaza cada valor por tu clave real.
#  3. NUNCA subas el archivo .env a GitHub (ver .gitignore).
#  4. Estas claves SOLO viven aquí, en el backend. Jamás en React.
# ============================================================

# Clave de Cohere (embeddings) — https://dashboard.cohere.com/
COHERE_API_KEY=pega_aqui_tu_clave_de_cohere

# Clave de Google Gemini (generación) — https://aistudio.google.com/
GEMINI_API_KEY=pega_aqui_tu_clave_de_gemini

# Datos de Supabase (base vectorial) — Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=pega_aqui_tu_clave_service_role

# Puerto del backend (opcional; por defecto 3000)
# PORT=3000
